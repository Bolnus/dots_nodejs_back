generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DotsRoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum DotsRoomMemberRole {
  PLAYER0
  PLAYER1
  VIEWER
}

enum DotsChatSenderKind {
  AI
  PLAYER
  VIEWER
}

model DotsUser {
  id               String              @id @default(uuid())
  displayName      String
  normalizedName   String              @unique
  sessionTokenHash String
  lastSeenAt       DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  members          DotsRoomMember[]
  ownedRooms       DotsRoom[]          @relation("RoomOwner")
  aiRooms          DotsRoom[]          @relation("RoomAiPlayer")
  chatMessages     DotsChatMessage[]
}

model DotsRoom {
  id                  String           @id @default(uuid())
  name                String
  ownerUserId         String
  owner               DotsUser         @relation("RoomOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  aiPlayerUserId      String?
  aiPlayer            DotsUser?        @relation("RoomAiPlayer", fields: [aiPlayerUserId], references: [id], onDelete: SetNull)
  status              DotsRoomStatus   @default(WAITING)
  isPrivate           Boolean          @default(false)
  passwordHash        String?
  rows                Int
  cols                Int
  serverState         Json?
  presence            Json?
  presenceByUserId    String?
  lockedPlayer0UserId String?
  lockedPlayer1UserId String?
  createdAt           DateTime         @default(now())
  members             DotsRoomMember[]
  chat                DotsChat?
}

model DotsChat {
  id         String              @id @default(uuid())
  roomId     String              @unique
  room       DotsRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())
  messages   DotsChatMessage[]
  readStates DotsChatReadState[]
}

model DotsChatReadState {
  chatId       String
  chat         DotsChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId       String
  lastReadAtMs BigInt
  updatedAt    DateTime @updatedAt

  @@id([chatId, userId])
}

model DotsChatMessage {
  id           String             @id @default(uuid())
  chatId       String
  chat         DotsChat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderKind   DotsChatSenderKind
  senderUserId String?
  senderUser   DotsUser?          @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  content      String
  createdAt    DateTime           @default(now())

  @@index([chatId, createdAt])
}

model DotsRoomMember {
  id     String             @id @default(uuid())
  roomId String
  userId String
  role   DotsRoomMemberRole
  room   DotsRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   DotsUser           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}
