NODE_ENV=production

# PostgreSQL connection string (Amvera: use internal DB hostname from the DB project Info tab)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Comma-separated allowed frontend origins for CORS
FRONTEND_URLS=https://your-frontend.example.com

# Bark admin push notifications (device key from the Bark iOS app)
BARK_URL=your_bark_device_key
# BARK_SERVER_URL=https://api.day.app
# BARK_NOTIFY_MAX_PER_MINUTE=10

# Optional (defaults shown)
EXPRESS_HOST=0.0.0.0
# EXPRESS_PORT — omit on Amvera to use platform PORT (80); local default is 3030
DOTS_MAX_ACTIVE_ROOMS=30
DOTS_MAX_USERS=500
DOTS_MAX_CHAT_MESSAGES_PER_ROOM=10000
DOTS_IDLE_USER_TTL_HOURS=24

# LLM (required for vs-AI mode)
LLM_HOST=http://localhost:11434/v1
LLM_MODEL=llama3.2
# LLM_API_KEY=your_gemini_api_key
LLM_MAX_RETRIES=3
